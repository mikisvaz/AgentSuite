Research=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
 workflow.rb
 start_chat
 chats=chats filter="*"{
  path_kinds
 }
 lib=lib{
  Research=Research{
   path_kinds.rb
   path_kinds=path_kinds{
    records.rb
   }
  }
 }
 test=test {
  test_helper.rb
 }
}
